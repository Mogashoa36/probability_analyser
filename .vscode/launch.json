
{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Backend: Spring Boot (:8081)",
      "request": "launch",
      "mainClass": "com.betanalyzer.BetAnalyzerApplication",
      "cwd": "${workspaceFolder}/backend",
      "args": [
        "--server.port=8081"
      ],
      "console": "integratedTerminal"
    },
    {
      "type": "node-terminal",
      "name": "Frontend: Angular (:4200)",
      "request": "launch",
      "command": "npm start",
      "cwd": "${workspaceFolder}/frontend",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://localhost:4200/?)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Bet Analyzer",
      "configurations": [
        "Backend: Spring Boot (:8081)",
        "Frontend: Angular (:4200)"
      ],
      "stopAll": true
    }
  ]
}